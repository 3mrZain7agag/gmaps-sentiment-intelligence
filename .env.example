# Copy this file to .env and fill in the values. Never commit .env to GitHub.
# Shared Supabase DB: use the Session pooler details from the team doc (Supabase > Connect).
# Your role password is shared privately; never commit it.
POSTGRES_HOST=<session-pooler-host>
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=<role>.<project-ref>
POSTGRES_PASSWORD=change_me

# Local Docker only (optional)
DA_PASSWORD=change_me_da
DS_PASSWORD=change_me_ds

RAPIDAPI_KEY=